<Project>
	<ItemGroup>
		<!-- 异步锁 -->
		<PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
		<!-- 多次重试间隔时间可变 -->
		<PackageReference Include="Polly" Version="8.6.6" />
		<PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
		<PackageReference Include="StackExchange.Redis" Version="2.13.1" />
		
		<!-- 日志，两端版本相同 -->
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Extensions.ElapsedTime" Version="2.1.3" />
		
		<!-- Db相关，两端版本相同 -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
        <PackageReference Include="MySqlConnector" Version="2.6.1" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
        <PackageReference Include="Dapper" Version="2.1.79" />
	</ItemGroup>
</Project>
