<a:Win
    x:Class="Demo.UI.PdfViewDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:Dt.Base">

    <a:Main>
        <a:Tabs>
            <a:Tab Title="Pdf浏览器" Order="1">
                <a:PdfView x:Name="_pdf" />
            </a:Tab>
        </a:Tabs>
    </a:Main>
    <a:Pane Pos="Right">
        <a:Tabs>
            <a:Tab Title="属性" Order="2">
                <a:Fv Data="{Binding ElementName=_pdf}">
                    <Button Content="打开pdf文件" Click="OnJsOpen" />
                    <Button Content="选择并打开pdf文件" Click="OnOpenFile" />
                </a:Fv>
            </a:Tab>
        </a:Tabs>
    </a:Pane>
</a:Win>
